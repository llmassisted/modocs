<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup and device-transfer rules for Android 12 (API 31) and above.

  See backup_rules.xml for why the recents database is excluded. It is left out
  of device transfer too: the content URIs it stores are not valid on the
  destination device, so transferring them only produces broken entries.

  Keep in sync with backup_rules.xml and with the database name in StorageModule.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="modocs.db" />
        <exclude domain="database" path="modocs.db-shm" />
        <exclude domain="database" path="modocs.db-wal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="modocs.db" />
        <exclude domain="database" path="modocs.db-shm" />
        <exclude domain="database" path="modocs.db-wal" />
    </device-transfer>
</data-extraction-rules>
